# Salin file ini menjadi ".env" dan sesuaikan nilainya.
# Jangan commit file ".env" yang berisi kredensial asli.

APP_ENV=development

# Base URL Laravel API (tanpa trailing slash)
API_BASE_URL=https://api-dev.church-app.example.com/api/v1

# Timeout (dalam milidetik)
API_CONNECT_TIMEOUT=15000
API_RECEIVE_TIMEOUT=15000

# Firebase (opsional, biasanya sudah dihandle oleh google-services.json / GoogleService-Info.plist)
FIREBASE_PROJECT_ID=

# Feature flags
ENABLE_LOGGING=true
